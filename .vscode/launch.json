    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: FastAPI",
            "python": "${workspaceFolder}/.venv/bin/python",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "manage:app",
                "--reload",
                "--port", "16789",
